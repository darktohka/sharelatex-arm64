From 4b6527e60b9127b205df69c1e40d4c2abd2e84b1 Mon Sep 17 00:00:00 2001
From: Disyer <daniel@tohka.us>
Date: Sun, 12 Jul 2026 14:03:00 +0300
Subject: [PATCH 2/2] feat: add SameSite and Partitioned cookie env vars for
 cross-origin iframe embedding

Add OVERLEAF_SAME_SITE_COOKIE env var to control the SameSite attribute
of the session cookie. Setting this to 'none' (with OVERLEAF_SECURE_COOKIE=true)
allows the Overleaf editor to be embedded in a cross-origin iframe.

Add OVERLEAF_PARTITIONED_COOKIE env var to set the 'Partitioned' attribute
on the session cookie for CHIPS support, required by some browsers when
embedding in cross-site iframes.

The 'Partitioned' attribute is not natively supported by any version of the
'cookie' module (the project has three: 0.2.3, 0.4.1, ~0.7.1). Instead of
patching a specific copy, a middleware intercepts res.setHeader('Set-Cookie')
to append '; Partitioned' at the response level, catching cookies from all
sources (express-session, res.cookie(), etc).
---
 server-ce/config/settings.js                  |  8 +++++++
 .../web/app/src/infrastructure/Server.mjs     | 22 +++++++++++++++++++
 services/web/config/settings.defaults.js      |  5 +++++
 3 files changed, 35 insertions(+)

diff --git a/server-ce/config/settings.js b/server-ce/config/settings.js
index 67832fee6d..dca64da7b8 100644
--- a/server-ce/config/settings.js
+++ b/server-ce/config/settings.js
@@ -248,6 +248,14 @@ const settings = {
   // cookie with a secure flag (recommended).
   secureCookie: process.env.OVERLEAF_SECURE_COOKIE != null,
 
+  // 'SameSite' cookie setting for cross-origin iframe support.
+  // 'lax' (default), 'none' (required for cross-origin iframes), or 'strict'
+  sameSiteCookie: process.env.OVERLEAF_SAME_SITE_COOKIE || 'lax',
+
+  // Set 'Partitioned' attribute on the session cookie for CHIPS support.
+  // Required when embedding in cross-site iframes with cookie partitioning.
+  partitionedCookie: process.env.OVERLEAF_PARTITIONED_COOKIE === 'true',
+
   // If you are running Overleaf Community Edition behind a proxy (like Apache, Nginx, etc)
   // then set this to true to allow it to correctly detect the forwarded IP
   // address and http/https protocol information.
diff --git a/services/web/app/src/infrastructure/Server.mjs b/services/web/app/src/infrastructure/Server.mjs
index 057dd51e60..42c370ceb8 100644
--- a/services/web/app/src/infrastructure/Server.mjs
+++ b/services/web/app/src/infrastructure/Server.mjs
@@ -183,6 +183,28 @@ SessionAutostartMiddleware.applyInitialMiddleware(webRouter)
 await Modules.applyMiddleware(webRouter, 'sessionMiddleware', {
   store: sessionStore,
 })
+
+// Intercept Set-Cookie to append '; Partitioned' when enabled (CHIPS).
+// This must run before the session middleware so its Set-Cookie call
+// is patched. Patches res.setHeader per-request to catch cookies from
+// any source (express-session, res.cookie(), etc) regardless of which
+// version of the 'cookie' module generated them.
+const PartitionedCookieMiddleware = (req, res, next) => {
+  if (Settings.partitionedCookie) {
+    const origSetHeader = res.setHeader.bind(res)
+    res.setHeader = function (name, value) {
+      if (name.toLowerCase() === 'set-cookie') {
+        value = Array.isArray(value)
+          ? value.map(v => v + '; Partitioned')
+          : value + '; Partitioned'
+      }
+      return origSetHeader(name, value)
+    }
+  }
+  next()
+}
+webRouter.use(PartitionedCookieMiddleware)
+
 webRouter.use(
   session({
     resave: false,
diff --git a/services/web/config/settings.defaults.js b/services/web/config/settings.defaults.js
index c08e61739a..ba6a7e53db 100644
--- a/services/web/config/settings.defaults.js
+++ b/services/web/config/settings.defaults.js
@@ -671,6 +671,11 @@ module.exports = {
   // https://tools.ietf.org/html/draft-ietf-httpbis-rfc6265bis-03#section-4.1.2.7
   sameSiteCookie: 'lax',
 
+  // Set the 'Partitioned' attribute on the session cookie for CHIPS support.
+  // Required when embedding in cross-site iframes with cookie partitioning.
+  // Turn on via OVERLEAF_PARTITIONED_COOKIE env var.
+  partitionedCookie: false,
+
   // If you are running Overleaf behind a proxy (like Apache, Nginx, etc)
   // then set this to true to allow it to correctly detect the forwarded IP
   // address and http/https protocol information.
